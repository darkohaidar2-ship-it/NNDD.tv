{
  "rewrites": [
    {
      "source": "/api/xtream/:mac_address/:action",
      "destination": "/api/xtream?mac_address=:mac_address&action=:action"
    },
    {
      "source": "/((?!api/|.*\\.(?:apk|png|jpg|jpeg|svg|json|ico|js|css|woff2|woff|ttf|txt)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"kobin-tv.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
